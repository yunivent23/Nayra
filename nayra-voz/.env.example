# Variables del servicio de voz (D-017). No subir valores reales al repositorio.
# Token compartido con el backend (mismo valor que NAYRA_VOZ_TOKEN en Nayra-Back)
NAYRA_VOZ_TOKEN=
# Clave AES-256 en base64 para cifrar embeddings (D-039): python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Si se pierde, los perfiles de voz existentes no se pueden descifrar y los usuarios deben re-enrolarse.
NAYRA_VOZ_CLAVE_CIFRADO=
# Conexión con el usuario nayra_voz (solo esquema biometria)
NAYRA_VOZ_DB_DSN=postgresql://nayra_voz:CAMBIAR@localhost:5432/nayra
# Carpeta de modelos descargados por scripts/descargar_modelos.sh
NAYRA_VOZ_MODELOS_DIR=./modelos
# Agresividad del detector de voz WebRTC (0-3), parámetro del algoritmo de calidad
NAYRA_VOZ_VAD_AGRESIVIDAD=2
