# Plantilla de variables para docker-compose.yml. Copiar a .env y completar; .env NUNCA se versiona (D-017).
# En GCP, los valores marcados [SECRETO] salen de Secret Manager y el .env se genera en la VM al arrancar.
# Contraseñas: usar valores aleatorios alfanuméricos (sin espacios), porque NAYRA_VOZ_BD las lleva en la cadena
# de conexión.

# --- PostgreSQL ---------------------------------------------------------------------------------------------
# Solo local: superusuario del contenedor postgres (en Cloud SQL lo gestiona GCP).  [SECRETO]
POSTGRES_PASSWORD=
NAYRA_DB_NOMBRE=nayra
# Red y host que usa la tarea de migraciones.
#   Local (Docker Desktop en Windows/macOS o Docker en Linux): la red interna de Compose y el servicio postgres.
#   No se usa "host" en local porque en Docker Desktop esa red es la de la máquina virtual, no la de Windows.
#   GCP (D-071): NAYRA_RED_MIGRACIONES=host y NAYRA_DB_HOST = IP privada de Cloud SQL.
NAYRA_RED_MIGRACIONES=nayra_default
NAYRA_DB_HOST=postgres
# Host visto por nayra-back y nayra-voz. Local: postgres. GCP: IP privada de Cloud SQL.
NAYRA_DB_HOST_CONTENEDORES=postgres
NAYRA_DB_PORT=5432
# Local: disable. GCP (Cloud SQL con SSL exigido): require.
NAYRA_DB_SSLMODE=disable

# Usuario de migración del esquema nayra (dueño de la base; solo lo usa la tarea puntual de Flyway).
NAYRA_DB_USUARIO_MIGRACION=nayra_migracion
NAYRA_DB_PASSWORD_MIGRACION=                 # [SECRETO]
# Usuario de ejecución de Nayra-Back (recibe los permisos de V004/V011; sin UPDATE/DELETE en auditoria).
NAYRA_DB_USUARIO_APP=nayra_app
NAYRA_DB_PASSWORD_APP=                       # [SECRETO]
# Roles por servicio de V011 (sin login; PROVISIONAL hasta separar Negocio y Autenticación, P-4).
NAYRA_DB_ROL_NEGOCIO=nayra_negocio
NAYRA_DB_ROL_AUTENTICACION=nayra_autenticacion
# Usuario de migración del esquema biometria (historial propio, D-051).
NAYRA_DB_USUARIO_BIOMETRIA_MIGRACION=biometria_migracion
NAYRA_DB_PASSWORD_BIOMETRIA_MIGRACION=       # [SECRETO]
# Usuario de ejecución de Nayra-Voz (solo biometria.perfiles_voz, D-013).
NAYRA_DB_USUARIO_BIOMETRIA=nayra_biometria
NAYRA_DB_PASSWORD_BIOMETRIA=                 # [SECRETO]

# --- Nayra-Back ---------------------------------------------------------------------------------------------
# Clave HS256 del JWT de sesión: 32 bytes aleatorios en base64 (openssl rand -base64 32). La MISMA en las
# 2 instancias; si falta, el arranque falla (sin ella cada instancia inventaría su propia clave). P-5.  [SECRETO]
NAYRA_JWT_CLAVE=
# Puerto publicado en el host (el balanceador llega a la VM por aquí).
NAYRA_BACK_PUERTO_HOST=8080

# --- Nayra-Voz ----------------------------------------------------------------------------------------------
# Token de servicio Java -> Python (D-010), el mismo en ambos contenedores.  [SECRETO]
NAYRA_VOZ_TOKEN_SERVICIO=
# Clave AES-256-GCM de los embeddings: 32 bytes en base64. Si se pierde, los perfiles de voz no se pueden leer.  [SECRETO]
NAYRA_VOZ_CLAVE_EMBEDDINGS=
NAYRA_VOZ_CLAVE_EMBEDDINGS_VERSION=1

# --- Imágenes (GCP: rutas de Artifact Registry) -------------------------------------------------------------
NAYRA_IMAGEN_BACK=nayra-back:local
NAYRA_IMAGEN_VOZ=nayra-voz:local
