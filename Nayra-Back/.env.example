# Variables de entorno del backend (D-017). Copiar a un archivo local NO versionado o exportarlas en la terminal.
# Ningún secreto real debe subirse al repositorio.

# Base de datos
NAYRA_DB_URL=jdbc:postgresql://localhost:5432/nayra
NAYRA_DB_USER=
NAYRA_DB_PASSWORD=

# D-043: pepper del PIN. Valor aleatorio largo (p. ej. `openssl rand -base64 32`). Si cambia, los PIN existentes dejan de validar.
NAYRA_PIN_PEPPER=

# D-047: intentos fallidos antes del bloqueo. PENDIENTE DE DEFINIR por el equipo (obligatorio para arrancar).
NAYRA_INTENTOS_MAXIMO=

# D-048: vida útil del desafío y del nonce, formato ISO-8601 (p. ej. PT90S). PENDIENTE DE DEFINIR (obligatorio).
NAYRA_DESAFIO_VIGENCIA=

# D-042: duración máxima absoluta de la sesión (p. ej. PT1H). PENDIENTE DE DEFINIR (obligatorio).
# La inactividad de 5 minutos es fija por decisión aprobada.
NAYRA_SESION_DURACION_MAXIMA=

# D-040: servicio de voz interno
NAYRA_VOZ_URL=http://localhost:8001
NAYRA_VOZ_TOKEN=
# Valores iniciales de la propuesta aprobada: conexión ~2 s, lectura ~10 s; a medir en el prototipo.
NAYRA_VOZ_TIMEOUT_CONEXION=PT2S
NAYRA_VOZ_TIMEOUT_LECTURA=PT10S

# D-038: umbrales PENDIENTES DE CALIBRACIÓN. Vacíos => modo calibración (no se autentica por voz).
NAYRA_UMBRALES_VERSION=
NAYRA_UMBRAL_SIMILITUD=
NAYRA_UMBRAL_SPOOFING=
NAYRA_UMBRAL_VOZ_NETA=
NAYRA_UMBRAL_SNR=
NAYRA_UMBRAL_SATURACION=
NAYRA_UMBRAL_CONFIANZA_CONTENIDO=
NAYRA_UMBRAL_CONSISTENCIA=

# Pruebas de integración (opcional): base de datos de pruebas que se BORRA en cada prueba.
# NAYRA_IT_DB_URL=jdbc:postgresql://localhost:5432/nayra_test
